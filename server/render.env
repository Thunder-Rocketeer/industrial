# ==============================================================================
# Backend configuration for the Render deployment.
#
# Loaded automatically -- and ONLY -- when the process runs on Render, which
# is detected through the RENDER variable Render sets on every service. Local
# development never reads this file; it reads server/.env as before.
#
# Precedence, lowest to highest: this file -> Render's dashboard environment.
# So anything set in the dashboard wins, and the three values that must never
# be committed stay there:
#
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   SECRET_KEY            (32+ chars; python -c "import secrets; print(secrets.token_urlsafe(64))")
#
# Everything below is public configuration: hostnames and feature switches.
# ==============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- Data source: the CSV exports checked in under server/ -----------------
DATA_SOURCE=csv
CSV_DATA_DIR=./supabase_csv_exports

# --- Redis is not provisioned; both features back onto it ------------------
# When a Redis instance exists, set REDIS_URL in the dashboard and flip these.
CACHE_ENABLED=false
RATE_LIMIT_ENABLED=false

# --- Frontend: Vercel, which proxies /api/* to this service -----------------
# The browser only ever talks to the Vercel origin, so the OAuth callback and
# the post-login redirects are on the Vercel host, not on onrender.com.
CORS_ALLOWED_ORIGINS=https://industrial-ui.vercel.app
GOOGLE_REDIRECT_URI=https://industrial-ui.vercel.app/api/v1/auth/google/callback
FRONTEND_LOGIN_SUCCESS_URL=https://industrial-ui.vercel.app/dashboard
FRONTEND_LOGIN_FAILURE_URL=https://industrial-ui.vercel.app/login?error=auth_failed

# --- Cookies: HTTPS end to end, same-site through the proxy ----------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Sign-in policy: empty lists mean any Google account --------------------
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_ALLOWED_EMAILS=
AUTH_AUTO_PROVISION=true
AUTH_DEFAULT_ROLE=VIEWER
