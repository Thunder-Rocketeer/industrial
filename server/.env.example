# ==============================================================================
# Backend environment template.
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# Spec sections 27 and 65: .env is git-ignored and must never be committed.
# The values below are placeholders only -- no real secret belongs in this file.
#
# The Render deployment does not use .env. Its public configuration is the
# committed render.env (read automatically on Render); its secrets are set in
# the Render dashboard. See docs/deployment.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="Automobile Component Factory API"
# development | staging | production
APP_ENV=development
# Enables /docs and /redoc and verbose errors. Must be false in production.
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# Gunicorn worker count for production. Rule of thumb: (2 x CPU cores) + 1.
WORKERS=4
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# CORS (spec section 61)
# Explicit allow-list. Never "*" -- the browser sends credentialed requests.
# Comma-separated.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Data source
#
# csv      - load supabase_csv_exports/*.csv into an in-memory database at
#            startup. No network access; Supabase is never contacted. Default.
# postgres - query the Supabase PostgreSQL instance over DATABASE_URL.
# ------------------------------------------------------------------------------
DATA_SOURCE=csv
# Folder holding one <table>.csv per table. Defaults to server/supabase_csv_exports,
# relative to the server directory.
# CSV_DATA_DIR=./supabase_csv_exports

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL (spec section 11) - used when DATA_SOURCE=postgres
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It is backend-only and
# must never be sent to the browser or placed in any NEXT_PUBLIC_* variable.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# PostgreSQL connection used for aggregation queries.
#
# TWO TRAPS, both hit during Phase 7 verification:
#
# 1. USE THE POOLER HOST, NOT `db.<ref>.supabase.co`.
#    Supabase moved direct connections to IPv6-only. On an IPv4 network the
#    direct host does not resolve at all -- `getaddrinfo failed`, which reads
#    like a DNS outage rather than a configuration choice. The pooler is
#    reachable over IPv4 and the username gains a `.<project-ref>` suffix.
#      session mode (long-lived pools):  port 5432
#      transaction mode (serverless):    port 6543
#
# 2. PERCENT-ENCODE THE PASSWORD.
#    Supabase generates passwords containing `@`, `#` and other characters that
#    are structural in a URL. Unencoded, the URL silently parses wrong: `#`
#    starts a fragment and the host becomes empty. Encode it:
#      python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
#
DATABASE_URL=postgresql://postgres.your-project-ref:url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Redis (spec sections 12 and 60)
# ------------------------------------------------------------------------------
# Prefer 127.0.0.1 over `localhost`: on Windows the latter resolves to ::1
# first, and a Redis bound only to IPv4 is then unreachable with a timeout
# that looks like a dead server.
REDIS_URL=redis://127.0.0.1:6379/0
# Cache TTLs in seconds. Tunable per spec section 12.
CACHE_TTL_DASHBOARD=30
CACHE_TTL_TRENDS=300
CACHE_TTL_ANALYTICS=900
CACHE_TTL_REFERENCE=3600

# ------------------------------------------------------------------------------
# Security / JWT (spec section 55)
#
# Generate a strong SECRET_KEY, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=acf-dashboard
JWT_AUDIENCE=acf-dashboard-api
# Spec section 55.3: keep access tokens short-lived.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true in production so cookies are only sent over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (spec section 54.2)
#
# The redirect URI must be registered exactly in the Google Cloud console and
# must never be derived from an incoming Host header or query parameter.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match a redirect URI registered in the Google Cloud console *exactly*.
# Never derived from an incoming Host header (spec section 54.2).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OIDC_ISSUER=https://accounts.google.com
# Where the backend sends the browser after sign-in. Both must be on the
# frontend origin; the origin is taken from here, never from a query parameter.
FRONTEND_LOGIN_SUCCESS_URL=http://localhost:3000/
FRONTEND_LOGIN_FAILURE_URL=http://localhost:3000/login

# ------------------------------------------------------------------------------
# Account restriction (spec section 28)
#
# Enforced server-side after the Google identity has been verified. Both empty
# means ANY Google account can sign in -- acceptable for a local demo, and it
# must be narrowed for anything deployed.
#
# Comma-separated. Either list admits an address.
# ------------------------------------------------------------------------------
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_ALLOWED_EMAILS=

# When false, only users already in the database may sign in.
AUTH_AUTO_PROVISION=true
# Role given to an auto-provisioned user. Never taken from the request.
# One of: ADMIN, FACTORY_MANAGER, PRODUCTION_SUPERVISOR, QUALITY_ENGINEER,
# INVENTORY_MANAGER, VIEWER.
AUTH_DEFAULT_ROLE=VIEWER

# ------------------------------------------------------------------------------
# Session cookies
#
# COOKIE_SECURE must be true in production; startup refuses otherwise. It is
# false here because local development runs over plain HTTP, where a Secure
# cookie would never be sent.
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=acf_session
CSRF_COOKIE_NAME=acf_csrf
OAUTH_COOKIE_NAME=acf_oauth
OAUTH_TRANSACTION_MAX_AGE_SECONDS=600

# ------------------------------------------------------------------------------
# Rate limiting (spec section 60). Format: "<count>/<period>".
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OAUTH=10/minute
RATE_LIMIT_AUTHENTICATED=120/minute
RATE_LIMIT_ANALYTICS=30/minute
RATE_LIMIT_UNAUTHENTICATED=60/minute

# ------------------------------------------------------------------------------
# Seed data (spec section 30)
# Fixed seed so the same value always produces the same demo database.
# ------------------------------------------------------------------------------
SEED_RANDOM_SEED=20240101
SEED_HISTORY_DAYS=90
