# ---------------------------------------------------------------------------
# Browser end-to-end testing (Phase 8)
# ---------------------------------------------------------------------------
# Minted role sessions for the Playwright suite. These are real, signed access
# tokens with a fifteen-minute life, regenerated by `e2e/global-setup.ts` on
# every run. They must never be committed, and committing them would also be
# pointless -- they expire long before anyone could clone the repository.
client/e2e/.auth/

# Playwright's own run output: traces, videos, failure screenshots and the HTML
# report. Tens of megabytes, regenerated by every run, and meaningless without
# the run that produced them. The curated evidence screenshots in
# `artifacts/e2e/*.png` ARE committed -- they are the phase's deliverable.
artifacts/e2e/test-results/
client/playwright-report/
client/blob-report/
client/.playwright-mcp/
.playwright-mcp/
