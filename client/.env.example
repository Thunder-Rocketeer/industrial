# ---------------------------------------------------------------------------
# Frontend environment template.
#
# Spec section 39: this file may contain ONLY values that are safe to expose in
# the browser. Every NEXT_PUBLIC_* variable is inlined into the client bundle at
# build time and is readable by anyone who loads the page.
#
# Never put the following in this file or in any NEXT_PUBLIC_* variable:
#   - Supabase service-role key
#   - Google OAuth client secret
#   - JWT signing keys
#   - Database or Redis credentials
#
# Copy to .env.local and adjust for your machine:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, including the API version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout for the shared Axios client, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Human-readable application name, used in page titles and the app shell.
NEXT_PUBLIC_APP_NAME=Automobile Component Factory

# Deployment environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Serve a few endpoints from local fixtures instead of the backend.
# Development only: `next build` sets NODE_ENV=production, which disables
# mocking regardless of this value. Off unless set to exactly "true".
# See lib/api/mock/install.ts.
NEXT_PUBLIC_ENABLE_API_MOCKS=false
